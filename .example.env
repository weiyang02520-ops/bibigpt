# https://platform.openai.com/account/api-keys
# Optional for BYOK deployments: users can enter their own key in the web UI.
OPENAI_API_KEY=
# Optional: use OpenAI-compatible providers (falls back to OPENAI_API_KEY)
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini
OPENAI_COMPATIBLE_PROVIDER_NAME=openai-compatible
# Development only: permits an HTTP/private Base URL for the local mock server.
ALLOW_PRIVATE_OPENAI_BASE_URL=false

# https://www.bilibili.com
BILIBILI_SESSION_TOKEN=

# Optional: enables shared result caching. Personal BYOK requests are not rate limited.
# https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: enables account login. Personal BYOK deployments can leave these blank.
# https://supabase.com/docs/reference/javascript/initializing
SUPABASE_HOSTNAME=xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=https://${SUPABASE_HOSTNAME}


############ Optional #################

# https://docs.sentry.io/product/cli/configuration
SENTRY_AUTH_TOKEN=

# https://segment.com
NEXT_PUBLIC_SEGMENT_WRITEKEY=

NEXT_PUBLIC_SITE_URL=
INTERNAL_API_HOSTNAME=api.example.com
